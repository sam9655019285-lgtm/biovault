# BioVault environment variable reference.
#
# This file contains PLACEHOLDER / EXAMPLE values only -- there are no
# real secrets or credentials in this project. Copy this file to `.env`
# and adjust values for your own local setup or deployment, or simply
# set these as real environment variables using your shell/platform's
# own tooling. BioVault reads these directly via os.environ (see
# app/config.py) -- no .env-loading library is required to run it;
# using a `.env` file is only a convenience some tools/platforms offer.

# --- Backend connection (Phase 23/24) -------------------------------------

# Base URL the Streamlit app (and api/client.py) use to reach the
# FastAPI backend. Only relevant when BIOVAULT_USE_API=true.
BIOVAULT_API_URL=http://127.0.0.1:8000

# Whether Streamlit routes core operations through the backend API
# ("true") or calls app/modules/*.py directly ("false", the default and
# safest option -- the backend does not even need to be running).
BIOVAULT_USE_API=false

# --- Production / deployment (Phase 25) -----------------------------------

# "development" (default) or "production". Only affects the default
# log level and how the running service identifies itself in logs --
# never changes any DNA/encoding behavior.
BIOVAULT_ENV=development

# Python logging level for the backend: DEBUG, INFO, WARNING, ERROR.
# Defaults to DEBUG in development and INFO in production.
BIOVAULT_LOG_LEVEL=INFO

# Comma-separated list of additional allowed CORS origins for the
# backend API, e.g. for a deployed frontend. Leave unset/empty to keep
# the default localhost/127.0.0.1-only development behavior. Never set
# this to "*" -- list explicit origins only.
BIOVAULT_CORS_ORIGINS=

# Maximum file size (in megabytes) the backend's /api/encode endpoint
# will accept. Mirrors the Streamlit uploader's own limit by default.
BIOVAULT_MAX_UPLOAD_MB=2
